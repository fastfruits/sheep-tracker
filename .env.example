# Copy to .env and fill in. Both are read at build time by Expo.
#
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle by design — on a
# public website anyone can read them. That is expected for the anon key; what
# actually protects your data is the RLS policies in supabase/rls.sql.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
