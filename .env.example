# Copy to .env and fill in.
#
# NEXT_PUBLIC_* values are inlined into the JS bundle by design — on a public
# site anyone can read them. That is expected for the anon key; what actually
# protects your data is the RLS policies in supabase/rls.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — must NOT have a NEXT_PUBLIC_ prefix. Used by the report action
# to match sightings against every farmer's animals and write notification rows
# addressed to other users. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
