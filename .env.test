# Test environment. Committed on purpose — see the !.env.test exception in
# .gitignore — because `.env` is STILL loaded when NODE_ENV=test (only
# `.env.local` is skipped), and `.env` points at the hosted project. Without a
# committed `.env.test`, a fresh clone would fall through to production
# credentials for a suite that creates and deletes rows.
#
# These are the well-known local Supabase demo keys, not secrets: they only
# work against a stack running on this machine. Regenerate them for your own
# machine with `npx supabase status -o env` if the CLI changes key formats.
#
# tests/helpers/global-setup.ts overwrites all three at runtime from
# `supabase status`, so these values are documentation and a CI fallback
# rather than the source of truth.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Never send a real text from a test run. `outbox` records messages in the
# database instead of handing them to Twilio.
SMS_TRANSPORT=outbox
